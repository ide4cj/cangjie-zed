{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ide4cj/.github:renovate-preset"],
  "customManagers": [
    {
      "description": "the grammar extension.toml pins, at the head of its master; highlights.yml runs script/highlights.py on it in the PR",
      "customType": "regex",
      "managerFilePatterns": ["/^extension\\.toml$/"],
      "matchStrings": ["repository = \"(?<depName>https://github\\.com/[^\"]+/tree-sitter-cangjie)\"\\nrev = \"(?<currentDigest>[0-9a-f]{40})\""],
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    }
  ]
}
